{
  "name": "immunitywize-storefront",
  "version": "0.1.0",
  "private": true,
  "description": "Immunitywize — homemade Indian healthy snacking storefront",
  "scripts": {
    "images:manifest": "node scripts/image-manifest.mjs",
    "dev": "node scripts/image-manifest.mjs && next dev",
    "build": "node scripts/image-manifest.mjs && next build",
    "start": "next start",
    "typecheck": "node scripts/image-manifest.mjs && tsc --noEmit",
    "test": "node --test --experimental-strip-types src/lib/*.test.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
